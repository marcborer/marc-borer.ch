---
import HreflangLinks from '../components/HreflangLinks.astro';
import type { Lang } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const lang = (Astro.currentLocale || 'de') as Lang;

const defaultDescription = lang === 'de'
  ? 'Marc Borer, Senior ICT Systems Architect in Breitenbach: Hybrid Identity, Microsoft 365, Endpoint-Lifecycle und mit Attestree attestierte Software-Verteilung für Windows-Flotten.'
  : 'Marc Borer, Senior ICT Systems Architect in Breitenbach, Switzerland: hybrid identity, Microsoft 365, endpoint lifecycle and, with Attestree, attested software delivery for Windows fleets.';

const { title, description = defaultDescription, ogImage } = Astro.props;
// Cloudflare Web Analytics: Cloudflare injects the beacon for proxied sites; set
// PUBLIC_CF_BEACON_TOKEN at build time to render it here instead (cookieless either way).
const beaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const resolvedOgImage = ogImage
  ? `https://marc-borer.ch${ogImage}`
  : 'https://marc-borer.ch/og/default.png';
const canonicalUrl = Astro.url.href;
const isHomepage = Astro.url.pathname === '/' || Astro.url.pathname === '/en/' || Astro.url.pathname === '/en';

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Marc Borer",
  "jobTitle": "Senior ICT Systems Architect",
  "url": "https://marc-borer.ch",
  "email": "mailto:mb@marc-borer.ch",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Breitenbach",
    "addressRegion": "SO",
    "postalCode": "4226",
    "addressCountry": "CH"
  },
  "sameAs": [
    "https://github.com/marcborer",
    "https://linkedin.com/in/marc-b-6780ab5a/",
    "https://attestree.com"
  ],
  "knowsAbout": [
    "Enterprise Architecture",
    "Hybrid Identity",
    "Microsoft 365",
    "Microsoft Intune",
    "Endpoint Lifecycle Management",
    "Software Supply Chain Security",
    "SBOM",
    "in-toto / SLSA",
    "CI/CD Automation",
    "Security Monitoring",
    ".NET",
    "PowerShell",
    "Python"
  ]
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Marc Borer — Senior ICT Systems Architect",
  "url": "https://marc-borer.ch",
  "inLanguage": ["de-CH", "en"]
};
---

<!doctype html>
<html lang={lang === 'de' ? 'de-CH' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#EEF0F4" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0F1319" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'de' ? 'de_CH' : 'en_US'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={resolvedOgImage} />

    <title>{title}</title>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts (self-hosted) -->
    <link rel="preload" href="/fonts/archivo-latin-lSfdnoLg.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-sans-latin-1syxeKYY.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Global Styles -->
    <style is:global>
      @import '../styles/fonts.css';
      @import '../styles/global.css';
    </style>

    <!-- Theme: honour a stored choice; otherwise the OS preference applies through CSS -->
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('theme');
          if (theme === 'light' || theme === 'dark') {
            document.documentElement.dataset.theme = theme;
          }
        } catch (e) {}
      })();
    </script>

    <link rel="canonical" href={canonicalUrl} />
    <HreflangLinks />
    {isHomepage && (
      <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    )}
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <slot name="head" />
    {beaconToken && (
      <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: beaconToken })}></script>
    )}
  </head>
  <body>
    <a href="#main-content" class="skip-to-content">{lang === 'de' ? 'Zum Inhalt springen' : 'Skip to main content'}</a>
    <slot />
  </body>
</html>
