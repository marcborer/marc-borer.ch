---
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import DocSidebar from '../components/DocSidebar.astro';

interface NavChild {
  label: string;
  href: string;
}

interface NavItem {
  label: string;
  href?: string;
  children?: NavChild[];
}

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  sidebarTitle: string;
  sidebarItems: NavItem[];
  /** Apply the markdown prose styles (sub-pages rendered from .md). */
  prose?: boolean;
}

const { title, description, ogImage, sidebarTitle, sidebarItems, prose = false } = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <div class="page">
    <Nav />
    <div class="doc-container container">
      <DocSidebar title={sidebarTitle} items={sidebarItems} />
      <main class:list={['doc-content', { prose }]} id="main-content">
        <slot />
      </main>
    </div>
    <Footer />
  </div>
</BaseLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }

  .doc-container {
    flex: 1;
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: var(--space-12);
    padding-top: var(--space-8);
    padding-bottom: var(--space-16);
  }

  .doc-content {
    min-width: 0;
    max-width: 60rem;
  }

  .doc-content.prose {
    padding-top: var(--space-4);
  }

  @media (max-width: 860px) {
    .doc-container {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      padding-top: var(--space-4);
    }
  }
</style>
