---
import { getLangFromUrl, getLocalePath, useTranslations } from '../i18n/utils';

interface NavChild {
  label: string;
  href: string;
}

interface NavItem {
  label: string;
  href?: string;
  children?: NavChild[];
}

interface Props {
  title: string;
  items: NavItem[];
}

const { title, items } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = Astro.url.pathname.replace(/\/$/, '');

function localize(href: string): string {
  return getLocalePath(href, lang);
}

function isActive(href: string): boolean {
  return currentPath === localize(href);
}
---

<aside class="doc-sidebar">
  <nav class="doc-nav" aria-label={t('doc.navAria')}>
    <span class="doc-nav-eyebrow">{t('doc.caseStudy')}</span>
    <span class="doc-nav-title">{title}</span>
    <ul class="doc-nav-list" role="list">
      {items.map((item) =>
        'children' in item && item.children ? (
          <li class="doc-nav-group">
            <span class="doc-nav-group-label">{item.label}</span>
            <ul class="doc-nav-sublist" role="list">
              {item.children.map((child) => (
                <li>
                  <a
                    href={`${localize(child.href)}/`}
                    class:list={['doc-nav-link', { active: isActive(child.href) }]}
                    aria-current={isActive(child.href) ? 'page' : undefined}
                  >
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ) : (
          <li>
            <a
              href={`${localize(item.href!)}/`}
              class:list={['doc-nav-link', { active: isActive(item.href!) }]}
              aria-current={isActive(item.href!) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        )
      )}
    </ul>
  </nav>
</aside>

<style>
  .doc-sidebar {
    position: sticky;
    top: 5.5rem;
    align-self: start;
  }

  .doc-nav {
    display: grid;
    gap: var(--space-2);
  }

  .doc-nav-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .doc-nav-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-md);
    color: var(--ink);
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-2);
    border-bottom: var(--rule) solid var(--hairline);
  }

  .doc-nav-list {
    display: grid;
  }

  .doc-nav-link {
    display: block;
    padding: var(--space-2) 0 var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    color: var(--muted);
    border-left: 2px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .doc-nav-link:hover {
    color: var(--ink);
  }

  .doc-nav-link.active {
    color: var(--ink);
    border-left-color: var(--accent);
  }

  .doc-nav-group-label {
    display: block;
    padding: var(--space-3) 0 var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .doc-sidebar {
      position: static;
      border-bottom: var(--rule) solid var(--hairline);
      padding-bottom: var(--space-3);
    }

    .doc-nav {
      gap: var(--space-3);
    }

    .doc-nav-title {
      border-bottom: none;
      padding-bottom: 0;
      margin-bottom: 0;
    }

    .doc-nav-list {
      display: flex;
      gap: var(--space-2);
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      padding-bottom: var(--space-1);
    }

    .doc-nav-link {
      padding: var(--space-1) var(--space-3);
      border: var(--rule) solid var(--hairline-strong);
      border-radius: var(--radius-sm);
      white-space: nowrap;
      font-family: var(--font-mono);
      font-size: var(--text-xs);
    }

    .doc-nav-link.active {
      border-color: var(--accent);
      color: var(--accent);
    }
  }
</style>
