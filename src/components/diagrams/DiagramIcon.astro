---
// A small line-icon set for the architecture drawings, drawn on a 24-unit grid
// and scaled into place. Stroke-only, so it takes the theme colour it is given.
interface Props {
  name: 'globe' | 'server' | 'monitor' | 'person' | 'broker' | 'hypervisor' | 'vm' | 'cloud' | 'nope';
  x: number;
  y: number;
  size?: number;
  color?: string;
}
const { name, x, y, size = 22, color = 'var(--accent)' } = Astro.props;
const s = size / 24;
---

<g transform={`translate(${x} ${y}) scale(${s})`} fill="none" stroke={color} stroke-width={1.5 / s} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'globe' && (<>
    <circle cx="12" cy="12" r="9" />
    <ellipse cx="12" cy="12" rx="4" ry="9" />
    <path d="M3 12h18M4.5 7.5h15M4.5 16.5h15" />
  </>)}
  {name === 'server' && (<>
    <rect x="3.5" y="3.5" width="17" height="7" rx="1.5" />
    <rect x="3.5" y="13.5" width="17" height="7" rx="1.5" />
    <path d="M7 7h.01M7 17h.01M11 7h6M11 17h6" />
  </>)}
  {name === 'monitor' && (<>
    <rect x="3" y="4" width="18" height="12" rx="1.5" />
    <path d="M12 16v4M8.5 20h7" />
  </>)}
  {name === 'person' && (<>
    <circle cx="12" cy="8" r="3.5" />
    <path d="M5 20c0-3.9 3.1-6 7-6s7 2.1 7 6" />
  </>)}
  {name === 'broker' && (<>
    <rect x="3.5" y="5" width="17" height="14" rx="2" />
    <path d="M8 12h8M13.5 9.5 16 12l-2.5 2.5" />
  </>)}
  {name === 'hypervisor' && (<>
    <rect x="3.5" y="3.5" width="17" height="17" rx="2" />
    <path d="M3.5 9h17M3.5 15h17" />
  </>)}
  {name === 'vm' && (<>
    <rect x="3.5" y="3.5" width="17" height="17" rx="2" />
    <rect x="8" y="8" width="8" height="8" rx="1" stroke-dasharray="2 1.6" />
  </>)}
  {name === 'cloud' && (<>
    <path d="M7.5 18.5h9a4 4 0 0 0 .6-7.96A5.5 5.5 0 0 0 6.6 9.1 4.75 4.75 0 0 0 7.5 18.5z" />
  </>)}
  {name === 'nope' && (<>
    <circle cx="12" cy="12" r="8" />
    <path d="M6.5 17.5l11-11" />
  </>)}
</g>
