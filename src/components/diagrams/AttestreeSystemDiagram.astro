---
// Attestree system architecture: who connects to whom, and what stays closed.
// Grounded in attestree.com/architecture (flows, ports, egress). Only the server
// accepts connections; endpoints and the detonation broker dial out.
import type { Lang } from '../../i18n/utils';

const lang = (Astro.currentLocale || 'de') as Lang;
const copy = {
  de: {
    aria: 'Systemarchitektur von Attestree: Nur der Server nimmt Verbindungen an; Endpunkte und Detonation-Broker wählen hinaus; aus dem Internet lädt der Server nur herunter',
    internet: 'ÖFFENTLICHES INTERNET · NUR DOWNLOADS',
    dashed: 'gestrichelt: standardmässig aus',
    chips: ['winget-Manifeste', 'Hersteller-Installer', 'CVE + CISA KEV', 'Chocolatey · Scoop'],
    network: 'IHR NETZ',
    operator: ['Operator', 'Konsole im Browser', '4 Rollen · TOTP'],
    server: 'ATTESTREE-SERVER',
    platform: ['Plattform-Container', 'Konsole · Agent-API', 'winget-Feed · Broker-Endpunkt', 'Katalog · Rings · signiertes Audit'],
    postgres: ['PostgreSQL 18', 'nur intern'],
    tls: ['TLS', 'Proxy oder Caddy'],
    endpoints: 'WINDOWS-ENDPUNKTE',
    agent: ['Agent', 'Dienst als SYSTEM', 'wählt hinaus, kein offener Port'],
    shim: ['Shim → winget', 'nur gepinnter SHA-256', 'Änderungen in ~1 Minute'],
    host: 'DETONATION-HOST · OPTIONAL',
    broker: ['Broker', 'eigenes Konto · lauscht auf nichts'],
    hypervisor: ['Hyper-V', 'oder Proxmox'],
    sandbox: ['Sandbox-VM', 'Golden-Image-Klon', 'standardmässig offline'],
    toInternet: 'nur Downloads · SHA-256 geprüft',
    vendor: 'selten: Herstellerhost, SHA-256 gepinnt',
    toBroker: 'gRPC · gegenseitiges TLS · nur ausgehend',
    note: 'NUR DER SERVER NIMMT VERBINDUNGEN AN · ENDPUNKTE UND BROKER WÄHLEN HINAUS',
  },
  en: {
    aria: 'Attestree system architecture: only the server accepts connections; endpoints and the detonation broker dial out; from the internet the server only downloads',
    internet: 'PUBLIC INTERNET · DOWNLOADS ONLY',
    dashed: 'dashed: off by default',
    chips: ['winget manifests', 'vendor installers', 'CVE + CISA KEV', 'Chocolatey · Scoop'],
    network: 'YOUR NETWORK',
    operator: ['Operator', 'console in a browser', '4 roles · TOTP'],
    server: 'ATTESTREE SERVER',
    platform: ['Platform container', 'console · agent API', 'winget feed · broker endpoint', 'catalog · rings · signed audit'],
    postgres: ['PostgreSQL 18', 'internal only'],
    tls: ['TLS', 'proxy or Caddy'],
    endpoints: 'WINDOWS ENDPOINTS',
    agent: ['Agent', 'service as SYSTEM', 'dials out, no inbound port'],
    shim: ['Shim → winget', 'pinned SHA-256 only', 'changes in ~1 minute'],
    host: 'DETONATION HOST · OPTIONAL',
    broker: ['Broker', 'own account · listens on nothing'],
    hypervisor: ['Hyper-V', 'or Proxmox'],
    sandbox: ['Sandbox VM', 'golden-image clone', 'offline by default'],
    toInternet: 'downloads only · SHA-256 checked',
    vendor: 'rare: vendor host, SHA-256 pinned',
    toBroker: 'gRPC · mutual TLS · outbound only',
    note: 'ONLY THE SERVER ACCEPTS CONNECTIONS · ENDPOINTS AND BROKER DIAL OUT',
  },
}[lang === 'en' ? 'en' : 'de'];
const chips = copy.chips.map((label, i) => ({ label, x: 40 + i * 183, dashed: i === 3 }));
---

<div class="diagram attestree-diagram">
  <svg viewBox="0 0 800 560" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={copy.aria}>
    <title>{copy.aria}</title>
    <defs>
      <marker id="sys-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" fill="var(--accent)" />
      </marker>
      <marker id="sys-arrow-quiet" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" fill="var(--hairline-strong)" />
      </marker>
    </defs>

    <!-- Public internet -->
    <rect x="24" y="16" width="752" height="78" rx="6" fill="var(--surface-2)" stroke="var(--hairline-strong)" />
    <text class="dg-mono" x="40" y="36" fill="var(--muted)" font-size="10" font-weight="600">{copy.internet}</text>
    <text class="dg-mono" x="760" y="36" text-anchor="end" fill="var(--muted)" font-size="10">{copy.dashed}</text>
    {chips.map((chip) => (
      <g>
        <rect x={chip.x} y="48" width="171" height="30" rx="4" fill="var(--surface)" stroke="var(--hairline-strong)" stroke-dasharray={chip.dashed ? '3 3' : undefined} />
        <text x={chip.x + 85.5} y="67" text-anchor="middle" fill="var(--ink)" font-size="11">{chip.label}</text>
      </g>
    ))}

    <!-- Your network -->
    <rect x="24" y="116" width="752" height="404" rx="6" fill="none" stroke="var(--hairline-strong)" stroke-dasharray="6 4" />
    <text class="dg-mono" x="40" y="136" fill="var(--muted)" font-size="10" font-weight="600">{copy.network}</text>

    <!-- Operator -->
    <rect x="40" y="150" width="180" height="60" rx="6" fill="none" stroke="var(--hairline-strong)" />
    <text x="56" y="170" fill="var(--ink)" font-size="12" font-weight="600">{copy.operator[0]}</text>
    <text x="56" y="186" fill="var(--muted)" font-size="10.5">{copy.operator[1]}</text>
    <text x="56" y="200" fill="var(--muted)" font-size="10.5">{copy.operator[2]}</text>
    <line x1="220" y1="180" x2="258" y2="180" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#sys-arrow)" />
    <text class="dg-mono" x="239" y="173" text-anchor="middle" fill="var(--accent)" font-size="9">HTTPS</text>

    <!-- Server -->
    <rect x="260" y="140" width="280" height="180" rx="6" fill="var(--accent-wash)" stroke="var(--accent)" stroke-width="1.5" />
    <text class="dg-mono" x="276" y="158" fill="var(--accent)" font-size="10" font-weight="600">{copy.server}</text>
    <rect x="276" y="168" width="248" height="80" rx="4" fill="var(--surface)" stroke="var(--hairline-strong)" />
    <text x="290" y="186" fill="var(--ink)" font-size="12" font-weight="600">{copy.platform[0]}</text>
    <text x="290" y="202" fill="var(--muted)" font-size="10.5">{copy.platform[1]}</text>
    <text x="290" y="217" fill="var(--muted)" font-size="10.5">{copy.platform[2]}</text>
    <text x="290" y="232" fill="var(--muted)" font-size="10.5">{copy.platform[3]}</text>
    <rect x="276" y="258" width="124" height="48" rx="4" fill="var(--surface)" stroke="var(--hairline-strong)" />
    <text x="290" y="278" fill="var(--ink)" font-size="11.5" font-weight="600">{copy.postgres[0]}</text>
    <text x="290" y="294" fill="var(--muted)" font-size="10.5">{copy.postgres[1]}</text>
    <rect x="412" y="258" width="112" height="48" rx="4" fill="var(--surface)" stroke="var(--hairline-strong)" stroke-dasharray="3 3" />
    <text x="426" y="278" fill="var(--ink)" font-size="11.5" font-weight="600">{copy.tls[0]}</text>
    <text x="426" y="294" fill="var(--muted)" font-size="10.5">{copy.tls[1]}</text>

    <!-- Server downloads from the internet -->
    <line x1="400" y1="140" x2="400" y2="96" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#sys-arrow)" />
    <text x="392" y="109" text-anchor="end" fill="var(--muted)" font-size="10.5">{copy.toInternet}</text>

    <!-- Endpoints -->
    <rect x="580" y="140" width="180" height="180" rx="6" fill="none" stroke="var(--hairline-strong)" />
    <text class="dg-mono" x="596" y="158" fill="var(--accent)" font-size="10" font-weight="600">{copy.endpoints}</text>
    <text x="596" y="182" fill="var(--ink)" font-size="12" font-weight="600">{copy.agent[0]}</text>
    <text x="596" y="198" fill="var(--muted)" font-size="10.5">{copy.agent[1]}</text>
    <text x="596" y="212" fill="var(--muted)" font-size="10.5">{copy.agent[2]}</text>
    <text x="596" y="242" fill="var(--ink)" font-size="12" font-weight="600">{copy.shim[0]}</text>
    <text x="596" y="258" fill="var(--muted)" font-size="10.5">{copy.shim[1]}</text>
    <text x="596" y="272" fill="var(--muted)" font-size="10.5">{copy.shim[2]}</text>
    <line x1="580" y1="230" x2="542" y2="230" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#sys-arrow)" />
    <text class="dg-mono" x="561" y="223" text-anchor="middle" fill="var(--accent)" font-size="9">HTTPS</text>
    <!-- the rare direct vendor download, pinned to the SHA-256 -->
    <line x1="740" y1="140" x2="740" y2="96" stroke="var(--hairline-strong)" stroke-width="1.25" stroke-dasharray="2 3" marker-end="url(#sys-arrow-quiet)" />
    <text x="732" y="109" text-anchor="end" fill="var(--muted)" font-size="10">{copy.vendor}</text>

    <!-- Detonation host -->
    <line x1="400" y1="360" x2="400" y2="322" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#sys-arrow)" />
    <text x="410" y="345" fill="var(--muted)" font-size="10.5">{copy.toBroker}</text>
    <rect x="260" y="360" width="280" height="144" rx="6" fill="none" stroke="var(--hairline-strong)" stroke-dasharray="4 3" />
    <text class="dg-mono" x="276" y="378" fill="var(--accent)" font-size="10" font-weight="600">{copy.host}</text>
    <rect x="276" y="388" width="248" height="40" rx="4" fill="var(--surface)" stroke="var(--hairline-strong)" />
    <text x="290" y="404" fill="var(--ink)" font-size="11.5" font-weight="600">{copy.broker[0]}</text>
    <text x="290" y="420" fill="var(--muted)" font-size="10.5">{copy.broker[1]}</text>
    <line x1="334" y1="428" x2="334" y2="438" stroke="var(--hairline-strong)" stroke-width="1.25" marker-end="url(#sys-arrow-quiet)" />
    <rect x="276" y="440" width="104" height="54" rx="4" fill="var(--surface)" stroke="var(--hairline-strong)" />
    <text x="290" y="460" fill="var(--ink)" font-size="11.5" font-weight="600">{copy.hypervisor[0]}</text>
    <text x="290" y="476" fill="var(--muted)" font-size="10.5">{copy.hypervisor[1]}</text>
    <line x1="380" y1="467" x2="394" y2="467" stroke="var(--hairline-strong)" stroke-width="1.25" marker-end="url(#sys-arrow-quiet)" />
    <rect x="396" y="440" width="128" height="54" rx="4" fill="var(--surface)" stroke="var(--hairline-strong)" />
    <text x="408" y="456" fill="var(--ink)" font-size="11.5" font-weight="600">{copy.sandbox[0]}</text>
    <text x="408" y="471" fill="var(--muted)" font-size="10">{copy.sandbox[1]}</text>
    <text x="408" y="485" fill="var(--muted)" font-size="10">{copy.sandbox[2]}</text>

    <text class="dg-mono" x="400" y="544" text-anchor="middle" fill="var(--muted)" font-size="10">{copy.note}</text>
  </svg>
</div>

<style>
  .attestree-diagram svg text.dg-mono {
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }
</style>
