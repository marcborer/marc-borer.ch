---
// Attestree system architecture: who dials whom. Port dots mark the only
// component that accepts connections (the server); endpoints and the broker
// dial out. Grounded in attestree.com/architecture (flows, ports, egress).
import type { Lang } from '../../i18n/utils';
import DiagramIcon from './DiagramIcon.astro';

const lang = (Astro.currentLocale || 'de') as Lang;
const copy = {
  de: {
    claim: 'Nur der Server nimmt Verbindungen an. Endpunkte und Detonation-Broker wählen hinaus, und Installer erreichen die Sandbox über den Server, nie direkt aus dem Internet.',
    internet: 'Öffentliches Internet',
    optIn: 'gestrichelt: erst nach Freigabe',
    chips: ['winget-Manifeste', 'Hersteller-Installer', 'CVE + CISA KEV', 'Chocolatey · Scoop'],
    network: 'IHR NETZ',
    operator: ['Operator', 'Konsole im Browser'],
    server: ['Attestree-Server', 'Plattform · PostgreSQL 18'],
    endpoints: ['Endpunkte', 'Agent + Shim'],
    noPort: 'kein offener Port',
    console: 'Konsole',
    checkin: 'Check-in',
    checkinMeta: 'HTTPS · ~1 Min.',
    downloads: 'nur Downloads',
    downloadsMeta: 'SHA-256 geprüft',
    rare: 'selten: gepinnter Hash',
    host: 'DETONATION-HOST · OPTIONAL',
    broker: ['Broker', 'wählt hinaus'],
    hypervisor: ['Hyper-V', 'oder Proxmox'],
    sandbox: ['Sandbox-VM', 'offline'],
    pulls: 'holt Installer',
    returns: 'liefert Evidenz',
  },
  en: {
    claim: 'Only the server accepts connections. Endpoints and the detonation broker dial out, and installers reach the sandbox through the server, never straight from the internet.',
    internet: 'Public internet',
    optIn: 'dashed: only once allowed',
    chips: ['winget manifests', 'vendor installers', 'CVE + CISA KEV', 'Chocolatey · Scoop'],
    network: 'YOUR NETWORK',
    operator: ['Operator', 'browser console'],
    server: ['Attestree server', 'platform · PostgreSQL 18'],
    endpoints: ['Endpoints', 'agent + shim'],
    noPort: 'no inbound port',
    console: 'console',
    checkin: 'check-in',
    checkinMeta: 'HTTPS · ~1 min',
    downloads: 'downloads only',
    downloadsMeta: 'SHA-256 checked',
    rare: 'rare: pinned hash',
    host: 'DETONATION HOST · OPTIONAL',
    broker: ['Broker', 'dials out'],
    hypervisor: ['Hyper-V', 'or Proxmox'],
    sandbox: ['Sandbox VM', 'offline'],
    pulls: 'pulls installers',
    returns: 'returns evidence',
  },
}[lang === 'en' ? 'en' : 'de'];

const chips = copy.chips.map((label, i) => ({ label, x: 72 + i * 175, dashed: i === 3 }));
const sandboxNodes = [
  { icon: 'broker' as const, x: 344, w: 112, text: copy.broker },
  { icon: 'hypervisor' as const, x: 488, w: 104, text: copy.hypervisor },
  { icon: 'vm' as const, x: 624, w: 104, text: copy.sandbox },
];
---

<figure class="diagram attestree-diagram">
  <svg viewBox="0 0 800 504" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={copy.claim}>
    <defs>
      <marker id="sys-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" fill="var(--accent)" />
      </marker>
      <marker id="sys-arrow-quiet" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" fill="var(--muted)" />
      </marker>
    </defs>

    <!-- Public internet -->
    <rect x="24" y="16" width="752" height="76" rx="8" fill="var(--surface-2)" stroke="var(--hairline)" />
    <DiagramIcon name="globe" x={40} y={25} color="var(--muted)" />
    <text x="72" y="41" fill="var(--ink)" font-size="13" font-weight="600">{copy.internet}</text>
    <text class="dg-mono" x="760" y="41" text-anchor="end" fill="var(--muted)" font-size="10">{copy.optIn}</text>
    {chips.map((chip) => (
      <g>
        <rect x={chip.x} y="52" width="163" height="26" rx="13" fill="var(--surface)" stroke="var(--hairline-strong)" stroke-dasharray={chip.dashed ? '3 3' : undefined} />
        <text x={chip.x + 81.5} y="69" text-anchor="middle" fill="var(--ink-2)" font-size="11">{chip.label}</text>
      </g>
    ))}

    <!-- Your network -->
    <rect x="24" y="112" width="752" height="376" rx="10" fill="none" stroke="var(--hairline-strong)" stroke-dasharray="6 5" />
    <text class="dg-mono" x="40" y="132" fill="var(--muted)" font-size="10" font-weight="600">{copy.network}</text>

    <!-- Operator -->
    <rect x="40" y="172" width="144" height="100" rx="8" fill="var(--surface)" stroke="var(--hairline-strong)" />
    <DiagramIcon name="person" x={56} y={186} />
    <text x="56" y="232" fill="var(--ink)" font-size="13" font-weight="600">{copy.operator[0]}</text>
    <text x="56" y="249" fill="var(--muted)" font-size="11">{copy.operator[1]}</text>

    <!-- Server: the only component with open ports -->
    <rect x="304" y="172" width="192" height="100" rx="8" fill="var(--accent-wash)" stroke="var(--accent)" stroke-width="1.75" />
    <DiagramIcon name="server" x={320} y={186} />
    <text x="320" y="232" fill="var(--ink)" font-size="13" font-weight="600">{copy.server[0]}</text>
    <text x="320" y="249" fill="var(--muted)" font-size="11">{copy.server[1]}</text>

    <!-- Endpoints -->
    <rect x="616" y="172" width="144" height="100" rx="8" fill="var(--surface)" stroke="var(--hairline-strong)" />
    <DiagramIcon name="monitor" x={632} y={186} />
    <text x="632" y="232" fill="var(--ink)" font-size="13" font-weight="600">{copy.endpoints[0]}</text>
    <text x="632" y="249" fill="var(--muted)" font-size="11">{copy.endpoints[1]}</text>
    <DiagramIcon name="nope" x={631} y={256} size={11} color="var(--muted)" />
    <text class="dg-mono" x="646" y="265" fill="var(--muted)" font-size="9.5">{copy.noPort}</text>

    <!-- Operator → server -->
    <line x1="184" y1="216" x2="298" y2="216" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#sys-arrow)" />
    <text x="244" y="208" text-anchor="middle" fill="var(--ink-2)" font-size="11">{copy.console}</text>
    <text class="dg-mono" x="244" y="231" text-anchor="middle" fill="var(--accent)" font-size="9.5">HTTPS</text>

    <!-- Endpoints → server -->
    <line x1="616" y1="216" x2="502" y2="216" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#sys-arrow)" />
    <text x="556" y="208" text-anchor="middle" fill="var(--ink-2)" font-size="11">{copy.checkin}</text>
    <text class="dg-mono" x="556" y="231" text-anchor="middle" fill="var(--accent)" font-size="9.5">{copy.checkinMeta}</text>

    <!-- Server → internet -->
    <line x1="400" y1="172" x2="400" y2="95" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#sys-arrow)" />
    <text x="410" y="144" fill="var(--ink-2)" font-size="11">{copy.downloads}</text>
    <text class="dg-mono" x="410" y="159" fill="var(--muted)" font-size="9.5">{copy.downloadsMeta}</text>

    <!-- Endpoint → vendor host, rare -->
    <line x1="744" y1="172" x2="744" y2="95" stroke="var(--muted)" stroke-width="1.25" stroke-dasharray="2 3" marker-end="url(#sys-arrow-quiet)" />
    <text x="736" y="152" text-anchor="end" fill="var(--muted)" font-size="10.5">{copy.rare}</text>

    <!-- Detonation host: the broker sits under the server and dials up to it -->
    <rect x="312" y="336" width="448" height="132" rx="10" fill="none" stroke="var(--hairline-strong)" stroke-dasharray="4 4" />
    <text class="dg-mono" x="744" y="356" text-anchor="end" fill="var(--muted)" font-size="10" font-weight="600">{copy.host}</text>
    {sandboxNodes.map((node, i) => (
      <g>
        <rect x={node.x} y="368" width={node.w} height="84" rx="8" fill="var(--surface)" stroke="var(--hairline-strong)" />
        <DiagramIcon name={node.icon} x={node.x + 12} y={380} size={20} color={i === 2 ? 'var(--muted)' : 'var(--accent)'} />
        <text x={node.x + 12} y="422" fill="var(--ink)" font-size="12" font-weight="600">{node.text[0]}</text>
        <text x={node.x + 12} y="438" fill="var(--muted)" font-size="10.5">{node.text[1]}</text>
        {i < 2 && <line x1={node.x + node.w} y1="410" x2={node.x + node.w + 30} y2="410" stroke="var(--hairline-strong)" stroke-width="1.25" marker-end="url(#sys-arrow-quiet)" />}
      </g>
    ))}

    <!-- Broker → server: pulls installers, returns evidence -->
    <line x1="400" y1="368" x2="400" y2="278" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#sys-arrow)" />
    <text x="392" y="306" text-anchor="end" fill="var(--ink-2)" font-size="10.5">{copy.pulls}</text>
    <text x="392" y="321" text-anchor="end" fill="var(--muted)" font-size="10.5">{copy.returns}</text>
    <text class="dg-mono" x="408" y="306" fill="var(--accent)" font-size="9.5">gRPC · mTLS</text>

    <!-- Port dots: where the server accepts connections -->
    <g fill="var(--accent)" stroke="var(--surface)" stroke-width="2">
      <circle cx="304" cy="216" r="4.5" />
      <circle cx="496" cy="216" r="4.5" />
      <circle cx="400" cy="272" r="4.5" />
    </g>
  </svg>
  <figcaption class="diagram-caption">{copy.claim}</figcaption>
</figure>

<style>
  .attestree-diagram .diagram-caption {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: 1.55;
    max-width: 64ch;
  }

  .attestree-diagram svg text.dg-mono {
    font-family: var(--font-mono);
    letter-spacing: 0.05em;
  }
</style>
