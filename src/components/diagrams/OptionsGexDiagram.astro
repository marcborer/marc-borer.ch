---
// options-gex: Vertical research pipeline showing the falsification gate
// Chains + risk-free rate → GEX computation → Signal rules → Backtest
// (+ baselines, sweep) → 6-condition gate → Phase 2 live (gated).
---

<div class="diagram-container" data-animate="slide-up">
  <svg viewBox="0 0 800 560" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="options-gex Research Pipeline Diagram">
    <!-- Data sources -->
    <rect x="160" y="20" width="220" height="44" rx="8" fill="none" stroke="var(--color-border)" stroke-width="1" stroke-dasharray="4 3"/>
    <text x="270" y="40" text-anchor="middle" fill="var(--color-text-secondary)" font-size="12">Option Chains</text>
    <text x="270" y="56" text-anchor="middle" fill="var(--color-text-secondary)" font-size="10">Alpaca · historical OI</text>

    <rect x="420" y="20" width="220" height="44" rx="8" fill="none" stroke="var(--color-border)" stroke-width="1" stroke-dasharray="4 3"/>
    <text x="530" y="40" text-anchor="middle" fill="var(--color-text-secondary)" font-size="12">Risk-Free Rate</text>
    <text x="530" y="56" text-anchor="middle" fill="var(--color-text-secondary)" font-size="10">FRED</text>

    <!-- Arrows converge -->
    <line x1="270" y1="64" x2="380" y2="90" stroke="var(--color-accent)" stroke-width="1.5" opacity="0.5"/>
    <line x1="530" y1="64" x2="420" y2="90" stroke="var(--color-accent)" stroke-width="1.5" opacity="0.5"/>

    <!-- GEX Computation -->
    <rect x="240" y="95" width="320" height="55" rx="8" fill="var(--color-bg-elevated)" stroke="var(--color-accent)" stroke-width="1.5"/>
    <text x="400" y="118" text-anchor="middle" fill="var(--color-accent)" font-size="10" font-weight="600">GEX COMPUTATION</text>
    <text x="400" y="137" text-anchor="middle" fill="var(--color-text-secondary)" font-size="11">Call wall · Put wall · Gamma flip · Normalized GEX</text>

    <!-- Arrow -->
    <line x1="400" y1="150" x2="400" y2="175" stroke="var(--color-accent)" stroke-width="1.5" opacity="0.5"/>
    <polygon points="395,175 400,185 405,175" fill="var(--color-accent)" opacity="0.5"/>

    <!-- Signal Rules -->
    <rect x="260" y="185" width="280" height="50" rx="8" fill="var(--color-bg-elevated)" stroke="var(--color-accent)" stroke-width="1.5"/>
    <text x="400" y="207" text-anchor="middle" fill="var(--color-accent)" font-size="10" font-weight="600">SIGNAL RULES</text>
    <text x="400" y="225" text-anchor="middle" fill="var(--color-text-secondary)" font-size="11">Level-driven entries · level-driven exits</text>

    <!-- Arrow -->
    <line x1="400" y1="235" x2="400" y2="260" stroke="var(--color-accent)" stroke-width="1.5" opacity="0.5"/>
    <polygon points="395,260 400,270 405,260" fill="var(--color-accent)" opacity="0.5"/>

    <!-- Backtest -->
    <rect x="240" y="270" width="320" height="55" rx="8" fill="var(--color-bg-elevated)" stroke="var(--color-accent)" stroke-width="1.5"/>
    <text x="400" y="293" text-anchor="middle" fill="var(--color-accent)" font-size="10" font-weight="600">BACKTEST ENGINE</text>
    <text x="400" y="312" text-anchor="middle" fill="var(--color-text-secondary)" font-size="11">vs Baseline controls · single-parameter sweep</text>

    <!-- Arrow -->
    <line x1="400" y1="325" x2="400" y2="350" stroke="var(--color-accent)" stroke-width="1.5" opacity="0.5"/>
    <polygon points="395,350 400,360 405,350" fill="var(--color-accent)" opacity="0.5"/>

    <!-- Gate -->
    <rect x="230" y="360" width="340" height="55" rx="8" fill="var(--color-bg-elevated)" stroke="var(--color-accent)" stroke-width="2"/>
    <text x="400" y="383" text-anchor="middle" fill="var(--color-accent)" font-size="10" font-weight="600">6-CONDITION GO-LIVE GATE</text>
    <text x="400" y="402" text-anchor="middle" fill="var(--color-text-secondary)" font-size="11">Expectancy CI · cost multiple · drawdown · stability</text>

    <!-- Fail branch -->
    <line x1="570" y1="387" x2="690" y2="387" stroke="var(--color-border)" stroke-width="1.5" opacity="0.4"/>
    <rect x="685" y="368" width="95" height="38" rx="6" fill="var(--color-bg-secondary)" stroke="var(--color-border)" stroke-width="1"/>
    <text x="732" y="385" text-anchor="middle" fill="var(--color-text-secondary)" font-size="10">research-</text>
    <text x="732" y="398" text-anchor="middle" fill="var(--color-text-secondary)" font-size="10">only</text>

    <!-- Arrow pass -->
    <line x1="400" y1="415" x2="400" y2="440" stroke="var(--color-accent)" stroke-width="1.5" opacity="0.5"/>
    <polygon points="395,440 400,450 405,440" fill="var(--color-accent)" opacity="0.5"/>
    <text x="430" y="434" text-anchor="start" fill="var(--color-text-secondary)" font-size="10">all tickers pass</text>

    <!-- Phase 2 -->
    <rect x="595" y="120" width="175" height="120" rx="8" fill="none" stroke="var(--color-accent)" stroke-width="1" stroke-dasharray="6 4" opacity="0.4"/>
    <text x="682" y="143" text-anchor="middle" fill="var(--color-accent)" font-size="10" font-weight="600" opacity="0.7">PHASE 2 (GATED)</text>
    <rect x="610" y="155" width="145" height="32" rx="6" fill="var(--color-bg-secondary)" stroke="var(--color-border)" stroke-width="1"/>
    <text x="682" y="176" text-anchor="middle" fill="var(--color-text-secondary)" font-size="11">Live execution</text>
    <rect x="610" y="197" width="145" height="32" rx="6" fill="var(--color-bg-secondary)" stroke="var(--color-border)" stroke-width="1"/>
    <text x="682" y="218" text-anchor="middle" fill="var(--color-text-secondary)" font-size="11">Compose · observ.</text>

    <!-- Phase 2 box at bottom -->
    <rect x="260" y="450" width="280" height="44" rx="8" fill="var(--color-bg-secondary)" stroke="var(--color-border)" stroke-width="1"/>
    <text x="400" y="477" text-anchor="middle" fill="var(--color-text-secondary)" font-size="11">Phase 2 — live order routing (dual-signal gated)</text>

    <!-- Data layer -->
    <text x="400" y="528" text-anchor="middle" fill="var(--color-text-secondary)" font-size="11" font-weight="600" letter-spacing="0.1em">STORAGE</text>
    <rect x="240" y="538" width="150" height="18" rx="4" fill="none" stroke="var(--color-border)" stroke-width="1"/>
    <text x="315" y="551" text-anchor="middle" fill="var(--color-text-secondary)" font-size="10">SQLite (research)</text>
    <rect x="410" y="538" width="150" height="18" rx="4" fill="none" stroke="var(--color-border)" stroke-width="1"/>
    <text x="485" y="551" text-anchor="middle" fill="var(--color-text-secondary)" font-size="10">PostgreSQL (Phase 2)</text>
  </svg>
</div>

<style>
  .diagram-container {
    max-width: 50rem;
    margin: var(--space-8) auto;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-primary);
  }

  .diagram-container svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .diagram-container svg text {
    font-family: 'DM Sans', ui-sans-serif, system-ui, sans-serif;
  }
</style>
