---
import { getLangFromUrl, useTranslations, getLocalePath } from '../i18n/utils';

interface TimelineEntry {
  date: string;
  title: string;
  company: string | null;
  kind?: string;
  description: string[];
  projectLink: string | null;
}

interface Props {
  entries: TimelineEntry[];
  compact?: boolean;
}

const { entries, compact = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<ol class:list={['timeline', { 'timeline--compact': compact }]} role="list">
  {entries.map((entry, index) => (
    <li class="timeline-item">
      <div class="timeline-when">
        <span class="timeline-date">{entry.date}</span>
        {entry.kind && <span class="timeline-kind">{entry.kind}</span>}
      </div>
      <div class="timeline-marker" aria-hidden="true">
        <span class:list={['timeline-dot', { 'timeline-dot--current': index === 0 }]}></span>
      </div>
      <div class="timeline-content">
        <h3 class="timeline-title">{entry.title}</h3>
        {entry.company && <span class="timeline-company">{entry.company}</span>}
        {!compact && (
          <ul class="timeline-bullets">
            {entry.description.map((bullet) => <li>{bullet}</li>)}
          </ul>
        )}
        {!compact && entry.projectLink && (
          <a href={getLocalePath(entry.projectLink, lang)} class="link-arrow timeline-link">
            {entry.projectLink === '/projects/' ? t('experience.viewProjects') : t('experience.viewProject')}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        )}
      </div>
    </li>
  ))}
</ol>

<style>
  .timeline {
    display: grid;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 11rem 2rem minmax(0, 1fr);
    gap: 0 var(--space-4);
  }

  .timeline-when {
    display: grid;
    align-content: start;
    gap: var(--space-1);
    padding-block: var(--space-6);
    text-align: right;
  }

  .timeline-date {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .timeline-kind {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* The rule runs through the marker column; items join without gaps. */
  .timeline-marker {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .timeline-marker::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: var(--rule);
    background-color: var(--hairline-strong);
  }

  .timeline-item:first-child .timeline-marker::before {
    top: calc(var(--space-6) + 0.45rem);
  }

  .timeline-item:last-child .timeline-marker::before {
    bottom: auto;
    height: calc(var(--space-6) + 0.45rem);
  }

  .timeline-dot {
    position: relative;
    z-index: 1;
    display: block;
    width: 0.625rem;
    height: 0.625rem;
    margin-top: calc(var(--space-6) + 0.2rem);
    background-color: var(--paper);
    border: var(--rule) solid var(--ink);
    transform: rotate(45deg);
  }

  .timeline-dot--current {
    background-color: var(--accent);
    border-color: var(--accent);
  }

  .timeline-content {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-6);
    border-bottom: var(--rule) solid var(--hairline);
    min-width: 0;
  }

  .timeline-item:last-child .timeline-content {
    border-bottom: none;
  }

  .timeline-title {
    font-size: var(--text-xl);
    margin: 0;
  }

  .timeline-company {
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .timeline-bullets {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding-left: 0;
    list-style: none;
    max-width: var(--measure);
  }

  .timeline-bullets li {
    position: relative;
    padding-left: var(--space-5);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--ink-2);
  }

  .timeline-bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 0.75rem;
    height: var(--rule);
    background-color: var(--accent);
  }

  .timeline-link {
    margin-top: var(--space-3);
  }

  /* Compact variant (home page) */
  .timeline--compact .timeline-when,
  .timeline--compact .timeline-content {
    padding-block: var(--space-4);
  }

  .timeline--compact .timeline-dot {
    margin-top: calc(var(--space-4) + 0.3rem);
  }

  .timeline--compact .timeline-item:first-child .timeline-marker::before {
    top: calc(var(--space-4) + 0.55rem);
  }

  .timeline--compact .timeline-item:last-child .timeline-marker::before {
    height: calc(var(--space-4) + 0.55rem);
  }

  .timeline--compact .timeline-title {
    font-size: var(--text-lg);
  }

  @media (max-width: 700px) {
    .timeline-item {
      grid-template-columns: 1.5rem minmax(0, 1fr);
    }

    .timeline-when {
      grid-column: 2;
      grid-row: 1;
      padding-block: var(--space-5) 0;
      text-align: left;
      gap: var(--space-2);
      grid-auto-flow: column;
      justify-content: start;
      align-items: baseline;
    }

    .timeline-marker {
      grid-column: 1;
      grid-row: 1 / span 2;
      justify-content: start;
    }

    .timeline-marker::before {
      left: 0.25rem;
    }

    .timeline-dot {
      margin-top: calc(var(--space-5) + 0.2rem);
    }

    .timeline-item:first-child .timeline-marker::before {
      top: calc(var(--space-5) + 0.45rem);
    }

    .timeline-item:last-child .timeline-marker::before {
      height: calc(var(--space-5) + 0.45rem);
    }

    .timeline-content {
      grid-column: 2;
      grid-row: 2;
      padding-top: var(--space-2);
    }

    .timeline--compact .timeline-when {
      padding-top: var(--space-4);
    }

    .timeline--compact .timeline-dot {
      margin-top: calc(var(--space-4) + 0.2rem);
    }
  }
</style>
