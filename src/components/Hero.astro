---
import RingMark from './RingMark.astro';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';

const lang = (Astro.currentLocale || 'de') as Lang;
const t = useTranslations(lang);
const cvHref = lang === 'de'
  ? 'https://github.com/marcborer/cv/releases/latest/download/Lebenslauf.pdf'
  : 'https://github.com/marcborer/cv/releases/latest/download/CV-Marc-Borer-EN.pdf';
---

<section class="hero">
  <div class="hero-copy">
    <span class="eyebrow">{t('hero.eyebrow')}</span>
    <h1 class="hero-title">{t('hero.title')}</h1>
    <p class="hero-lead">{t('hero.lead')}</p>
    <div class="hero-cta">
      <a href={getRelativeLocaleUrl(lang, '/projects/')} class="btn btn--primary">
        {t('hero.cta.projects')}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <a href={cvHref} class="btn btn--ghost" target="_blank" rel="noopener noreferrer">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M4 19h16"/></svg>
        {t('hero.cta.cv')}
      </a>
    </div>
  </div>

  <figure class="hero-figure">
    <RingMark />
    <figcaption class="hero-figcaption">{t('hero.figure')}</figcaption>
  </figure>
</section>

<dl class="spec hero-spec">
  <div>
    <dt>{t('spec.role')}</dt>
    <dd>{t('spec.role.value')}</dd>
  </div>
  <div>
    <dt>{t('spec.focus')}</dt>
    <dd>{t('spec.focus.value')}</dd>
  </div>
  <div>
    <dt>{t('spec.now')}</dt>
    <dd>{t('spec.now.value')}</dd>
  </div>
  <div>
    <dt>{t('spec.since')}</dt>
    <dd>{t('spec.since.value')}</dd>
  </div>
</dl>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-12);
    align-items: center;
    padding-block: var(--space-16) var(--space-12);
  }

  .hero-copy {
    display: grid;
    gap: var(--space-6);
    justify-items: start;
  }

  .hero-title {
    font-size: var(--text-display);
    line-height: 1.02;
    letter-spacing: -0.02em;
    max-width: 14ch;
  }

  .hero-lead {
    font-size: var(--text-lg);
    line-height: var(--leading-prose);
    color: var(--muted);
    max-width: 52ch;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-2);
  }

  .hero-figure {
    display: grid;
    gap: var(--space-3);
    justify-items: center;
    margin: 0;
  }

  .hero-figure :global(.ringmark) {
    max-width: 30rem;
  }

  .hero-figcaption {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--muted);
    max-width: 36ch;
    justify-self: start;
    padding-left: var(--space-2);
    border-left: 2px solid var(--accent);
  }

  .hero-spec {
    margin-bottom: var(--space-4);
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      gap: var(--space-10);
      padding-block: var(--space-10) var(--space-10);
    }

    .hero-figure {
      justify-items: start;
    }

    .hero-figure :global(.ringmark) {
      max-width: 24rem;
    }
  }

  @media (max-width: 480px) {
    .hero-cta .btn {
      width: 100%;
    }
  }
</style>
