---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/utils';

const lang = (Astro.currentLocale || 'de') as Lang;
const t = useTranslations(lang);
---

<button class="theme-toggle" type="button" aria-label={t('nav.theme')} title={t('nav.theme')}>
  <span class="icon icon-sun" aria-hidden="true">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="4.5" />
      <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" />
    </svg>
  </span>
  <span class="icon icon-moon" aria-hidden="true">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z" />
    </svg>
  </span>
</button>

<script>
  function initThemeToggle() {
    const btn = document.querySelector('.theme-toggle');
    if (!btn) return;

    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const stored = root.dataset.theme;
      const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const current = stored ?? (systemDark ? 'dark' : 'light');
      const next = current === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch (e) {}
    });
  }

  initThemeToggle();
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: var(--rule) solid var(--hairline-strong);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .theme-toggle:hover {
    border-color: var(--ink);
    color: var(--accent);
  }

  .icon {
    display: none;
    line-height: 0;
  }

  /* Light (default): offer the moon */
  .icon-moon {
    display: inline-flex;
  }

  /* Dark by system preference: offer the sun */
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .icon-moon {
      display: none;
    }

    :global(:root:not([data-theme="light"])) .icon-sun {
      display: inline-flex;
    }
  }

  /* Dark by choice */
  :global(:root[data-theme="dark"]) .icon-moon {
    display: none;
  }

  :global(:root[data-theme="dark"]) .icon-sun {
    display: inline-flex;
  }
</style>
