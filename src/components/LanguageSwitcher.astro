---
import { languages } from '../i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getTranslatedPath } from '../i18n/utils';
import type { Lang } from '../i18n/utils';

const currentLocale = (Astro.currentLocale || 'de') as Lang;
const currentPath = Astro.url.pathname;

let basePath = currentPath;
if (currentLocale !== 'de' && currentPath.startsWith(`/${currentLocale}`)) {
  basePath = currentPath.slice(`/${currentLocale}`.length) || '/';
}
---

<nav class="lang" aria-label={currentLocale === 'de' ? 'Sprache' : 'Language'}>
  {Object.entries(languages).map(([lang, label]) => {
    const targetPath = getTranslatedPath(basePath, currentLocale, lang as Lang);
    return lang === currentLocale ? (
      <span class="lang-link active" aria-current="true" lang={lang}>{lang.toUpperCase()}</span>
    ) : (
      <a href={getRelativeLocaleUrl(lang, targetPath)} class="lang-link" lang={lang} hreflang={lang} title={label}>{lang.toUpperCase()}</a>
    );
  })}
</nav>

<style>
  .lang {
    display: inline-flex;
    align-items: center;
    border: var(--rule) solid var(--hairline-strong);
    border-radius: var(--radius-sm);
    overflow: hidden;
    height: 2.5rem;
  }

  .lang-link {
    display: inline-flex;
    align-items: center;
    height: 100%;
    padding: 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--muted);
    text-decoration: none;
  }

  .lang-link + .lang-link {
    border-left: var(--rule) solid var(--hairline-strong);
  }

  a.lang-link:hover {
    color: var(--ink);
    background-color: var(--accent-wash);
  }

  .lang-link.active {
    color: var(--accent-ink);
    background-color: var(--ink);
  }
</style>
