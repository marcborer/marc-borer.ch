---
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';

const lang = (Astro.currentLocale || 'de') as Lang;
const t = useTranslations(lang);
const pathname = Astro.url.pathname;

const links = [
  { label: t('nav.projects'), href: getRelativeLocaleUrl(lang, '/projects/') },
  { label: t('nav.skills'), href: getRelativeLocaleUrl(lang, lang === 'de' ? '/kompetenzen/' : '/skills/') },
  { label: t('nav.experience'), href: getRelativeLocaleUrl(lang, '/experience/') },
  { label: t('nav.principles'), href: getRelativeLocaleUrl(lang, lang === 'de' ? '/grundsaetze/' : '/principles/') },
  { label: t('nav.contact'), href: getRelativeLocaleUrl(lang, '/contact/') },
];

function isActive(href: string, current: string): boolean {
  return current.startsWith(href);
}
---

<header class="nav">
  <div class="nav-inner container">
    <a href={getRelativeLocaleUrl(lang, '/')} class="wordmark" aria-label={t('nav.homeAria')}>
      <span class="wordmark-name">Marc Borer</span>
      <span class="wordmark-role">{t('nav.wordmarkRole')}</span>
    </a>

    <nav aria-label={t('nav.aria')}>
      <ul class="nav-links" role="list">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={['nav-link', { active: isActive(link.href, pathname) }]}
              aria-current={isActive(link.href, pathname) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="nav-actions">
      <LanguageSwitcher />
      <ThemeToggle />
      <button
        class="hamburger"
        type="button"
        aria-label={t('nav.menu')}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <ul class="container" role="list">
      <li>
        <a href={getRelativeLocaleUrl(lang, '/')} class="mobile-link">{t('nav.home')}</a>
      </li>
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={['mobile-link', { active: isActive(link.href, pathname) }]}
            aria-current={isActive(link.href, pathname) ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  function initNav() {
    const hamburger = document.querySelector<HTMLButtonElement>('.hamburger');
    const mobileMenu = document.getElementById('mobile-menu');
    if (!hamburger || !mobileMenu) return;

    const setOpen = (open: boolean) => {
      hamburger.setAttribute('aria-expanded', String(open));
      hamburger.classList.toggle('open', open);
      mobileMenu.hidden = !open;
    };

    hamburger.addEventListener('click', () => {
      setOpen(hamburger.getAttribute('aria-expanded') !== 'true');
    });

    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !mobileMenu.hidden) {
        setOpen(false);
        hamburger.focus();
      }
    });
  }

  function initScrollEffect() {
    const nav = document.querySelector('.nav');
    if (!nav) return;
    const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 8);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  initNav();
  initScrollEffect();
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--nav-glass);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: var(--rule) solid transparent;
    transition: border-color 0.2s ease;
  }

  .nav.scrolled {
    border-bottom-color: var(--hairline);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    min-height: 4.25rem;
  }

  /* Wordmark */
  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-3);
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .wordmark-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-stretch: 118%;
    font-size: var(--text-md);
    letter-spacing: -0.01em;
  }

  .wordmark-role {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .wordmark:hover .wordmark-name {
    color: var(--accent);
  }

  /* Desktop links */
  .nav-links {
    display: flex;
    gap: var(--space-6);
  }

  .nav-link {
    position: relative;
    display: inline-block;
    padding: var(--space-2) 0;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
  }

  .nav-link:hover {
    color: var(--ink);
  }

  .nav-link.active {
    color: var(--ink);
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background-color: var(--accent);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  /* Hamburger */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: var(--rule) solid var(--hairline-strong);
    border-radius: var(--radius-sm);
    background: transparent;
    cursor: pointer;
  }

  .hamburger-bar {
    display: block;
    width: 1rem;
    height: 1.5px;
    background-color: var(--ink);
    transition: transform 0.2s ease;
  }

  .hamburger.open .hamburger-bar:nth-child(1) {
    transform: translateY(3.75px) rotate(45deg);
  }

  .hamburger.open .hamburger-bar:nth-child(2) {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  /* Mobile menu */
  .mobile-menu {
    display: none;
    border-top: var(--rule) solid var(--hairline);
    border-bottom: var(--rule) solid var(--hairline);
    background-color: var(--paper);
  }

  .mobile-menu:not([hidden]) {
    display: block;
  }

  .mobile-menu ul {
    display: grid;
    padding-block: var(--space-2);
  }

  .mobile-link {
    display: block;
    padding: var(--space-3) 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--ink);
    border-bottom: var(--rule) solid var(--hairline);
  }

  .mobile-menu li:last-child .mobile-link {
    border-bottom: none;
  }

  .mobile-link.active {
    color: var(--accent);
  }

  @media (max-width: 960px) {
    .wordmark-role {
      display: none;
    }
  }

  @media (max-width: 860px) {
    nav {
      display: none;
    }

    .hamburger {
      display: flex;
    }
  }
</style>
