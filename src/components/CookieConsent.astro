---
import type { Lang } from '../i18n/utils';

const lang = (Astro.currentLocale || 'de') as Lang;
const isDE = lang === 'de';
---

<div id="cookie-consent" class="cookie-banner" role="dialog" aria-label={isDE ? 'Cookie-Einstellungen' : 'Cookie settings'} hidden>
  <div class="cookie-inner container">
    <p class="cookie-text">
      {isDE
        ? <>Diese Website verwendet Google Analytics nur mit Ihrer Einwilligung. Ohne Zustimmung werden keine Analysedaten erhoben. <a href="/datenschutz/">Datenschutzerklärung</a></>
        : <>This site runs Google Analytics only with your consent. Without it, no analytics data is collected. <a href="/en/privacy/">Privacy policy</a></>}
    </p>
    <div class="cookie-actions">
      <button id="cookie-decline" class="btn btn--ghost" type="button">
        {isDE ? 'Ablehnen' : 'Decline'}
      </button>
      <button id="cookie-accept" class="btn btn--primary" type="button">
        {isDE ? 'Akzeptieren' : 'Accept'}
      </button>
    </div>
  </div>
</div>

<script>
  function initConsent() {
    const banner = document.getElementById('cookie-consent');
    const acceptBtn = document.getElementById('cookie-accept');
    const declineBtn = document.getElementById('cookie-decline');
    if (!banner || !acceptBtn || !declineBtn) return;

    try {
      if (localStorage.getItem('cookie-consent')) return;
    } catch (e) {}

    banner.hidden = false;

    acceptBtn.addEventListener('click', () => {
      try { localStorage.setItem('cookie-consent', 'accepted'); } catch (e) {}
      banner.hidden = true;
      if (typeof (window as any).loadGA === 'function') (window as any).loadGA();
    });

    declineBtn.addEventListener('click', () => {
      try { localStorage.setItem('cookie-consent', 'declined'); } catch (e) {}
      banner.hidden = true;
    });
  }

  initConsent();
</script>

<style>
  .cookie-banner {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 9999;
    background: var(--surface);
    border-top: var(--rule) solid var(--hairline);
    box-shadow: var(--shadow-float);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }

  .cookie-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding-block: var(--space-4);
  }

  .cookie-text {
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 70ch;
  }

  .cookie-text a {
    text-decoration: underline;
    text-decoration-color: var(--hairline-strong);
  }

  .cookie-actions {
    display: flex;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  .cookie-actions .btn {
    min-height: 2.5rem;
  }

  @media (max-width: 700px) {
    .cookie-inner {
      flex-direction: column;
      align-items: stretch;
    }

    .cookie-actions .btn {
      flex: 1;
    }
  }
</style>
