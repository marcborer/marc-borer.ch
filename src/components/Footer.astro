---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';

const lang = (Astro.currentLocale || 'de') as Lang;
const t = useTranslations(lang);
const isDE = lang === 'de';

const nav = [
  { label: t('nav.projects'), href: getRelativeLocaleUrl(lang, '/projects/') },
  { label: t('nav.skills'), href: getRelativeLocaleUrl(lang, isDE ? '/kompetenzen/' : '/skills/') },
  { label: t('nav.experience'), href: getRelativeLocaleUrl(lang, '/experience/') },
  { label: t('nav.principles'), href: getRelativeLocaleUrl(lang, isDE ? '/grundsaetze/' : '/principles/') },
  { label: t('nav.contact'), href: getRelativeLocaleUrl(lang, '/contact/') },
];
---

<footer class="footer">
  <div class="footer-inner container">
    <div class="footer-grid">
      <div class="footer-id">
        <span class="footer-name">Marc Borer</span>
        <span class="footer-role">{t('footer.role')}</span>
        <p class="footer-blurb">{t('footer.blurb')}</p>
      </div>

      <div class="footer-col">
        <span class="footer-label">{t('footer.navigate')}</span>
        <ul role="list">
          {nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>

      <div class="footer-col">
        <span class="footer-label">{t('footer.reach')}</span>
        <ul role="list">
          <li><a href="mailto:mb@marc-borer.ch">mb@marc-borer.ch</a></li>
          <li><a href="https://github.com/marcborer" target="_blank" rel="noopener noreferrer">github.com/marcborer</a></li>
          <li><a href="https://linkedin.com/in/marc-b-6780ab5a/" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
          <li><a href="https://attestree.com" target="_blank" rel="noopener noreferrer">attestree.com</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>{t('footer.copyright')}</span>
      <span class="footer-legal">
        <a href={isDE ? '/impressum/' : '/en/legal-notice/'}>{t('footer.impressum')}</a>
        <a href={isDE ? '/datenschutz/' : '/en/privacy/'}>{t('footer.privacy')}</a>
      </span>
      <span class="footer-stamp">{t('footer.stamp')}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: var(--rule) solid var(--hairline);
    margin-top: auto;
  }

  .footer-inner {
    padding-block: var(--space-12) var(--space-8);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-10);
    padding-bottom: var(--space-10);
    border-bottom: var(--rule) solid var(--hairline);
  }

  .footer-id {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  .footer-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-stretch: 118%;
    font-size: var(--text-lg);
    color: var(--ink);
  }

  .footer-role {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .footer-blurb {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--muted);
    max-width: 38ch;
  }

  .footer-col {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  .footer-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .footer-col ul {
    display: grid;
    gap: var(--space-2);
  }

  .footer-col a {
    font-size: var(--text-sm);
    color: var(--ink-2);
  }

  .footer-col a:hover {
    color: var(--accent);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    padding-top: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .footer-legal {
    display: inline-flex;
    gap: var(--space-5);
  }

  .footer-legal a {
    color: var(--muted);
  }

  .footer-legal a:hover {
    color: var(--accent);
  }

  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
