---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import RingMark from '../components/RingMark.astro';
---

<BaseLayout title="404 — Marc Borer">
  <div class="page">
    <Nav />
    <main class="error-page container" id="main-content">
      <div class="error-figure" aria-hidden="true">
        <RingMark labels={false} animate={false} />
      </div>
      <div class="error-content">
        <span class="eyebrow">404</span>
        <h1 class="error-heading" id="error-heading-de">Diese Seite gibt es nicht.</h1>
        <h1 class="error-heading" id="error-heading-en" hidden>This page does not exist.</h1>
        <p class="error-text" id="error-text-de">
          Die angeforderte Adresse existiert nicht oder wurde verschoben.
        </p>
        <p class="error-text" id="error-text-en" hidden>
          The address you asked for does not exist or has moved.
        </p>
        <div class="error-links" id="error-links-de">
          <a href="/" class="btn btn--primary">Startseite</a>
          <a href="/projects/" class="btn btn--ghost">Projekte</a>
          <a href="/contact/" class="btn btn--ghost">Kontakt</a>
        </div>
        <div class="error-links" id="error-links-en" hidden>
          <a href="/en/" class="btn btn--primary">Home</a>
          <a href="/en/projects/" class="btn btn--ghost">Projects</a>
          <a href="/en/contact/" class="btn btn--ghost">Contact</a>
        </div>
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>

<script is:inline>
  (function() {
    if (window.location.pathname.startsWith('/en/') || window.location.pathname === '/en') {
      ['heading', 'text', 'links'].forEach(function (k) {
        document.getElementById('error-' + k + '-de').hidden = true;
        document.getElementById('error-' + k + '-en').hidden = false;
      });
    }
  })();
</script>

<style>
  .page {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }

  .error-page {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-12);
    align-items: center;
    padding-block: var(--space-16);
  }

  .error-figure {
    max-width: 22rem;
    opacity: 0.6;
  }

  .error-content {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  .error-heading {
    font-size: var(--text-4xl);
  }

  .error-text {
    font-size: var(--text-lg);
    color: var(--muted);
    max-width: 40ch;
  }

  .error-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (max-width: 760px) {
    .error-page {
      grid-template-columns: 1fr;
    }

    .error-figure {
      max-width: 12rem;
    }
  }
</style>
