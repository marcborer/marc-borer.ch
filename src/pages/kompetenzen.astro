---
import PageLayout from '../layouts/PageLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';

const domains = [
  {
    title: 'Identity & Access',
    depth: 'Strategische Verantwortung',
    strategic: true,
    text: 'Hybride Identitätsarchitektur, Lifecycle-Automatisierung und unternehmensweite Authentifizierungsstrategie, mit Fokus auf Governance und die saubere Koexistenz von On-Premises und Cloud.',
    tech: 'Entra ID · Active Directory · Conditional Access · MFA · Graph API · Azure Automation',
    links: [{ label: 'Cloud & Hybrid Infrastructure', href: '/projects/cloud-infrastructure/architecture' }],
  },
  {
    title: 'Cloud & Messaging',
    depth: 'Strategische Verantwortung',
    strategic: true,
    text: 'Migration und Betrieb der unternehmensweiten Kommunikationsplattform: Architekturentscheid, Migrationsstrategie, Anbieterbewertung und unterbrechungsfreier Betrieb während der Umstellung.',
    tech: 'Exchange Online · Exchange Hybrid · Microsoft Teams · Direct Routing · SBC · PowerShell',
    links: [{ label: 'Cloud & Hybrid Infrastructure', href: '/projects/cloud-infrastructure/architecture' }],
  },
  {
    title: 'Software Supply Chain & Plattform-Engineering',
    depth: 'Hands-on Umsetzung',
    strategic: false,
    text: 'Entwurf und Bau einer Control Plane, die Software vor dem Rollout attestiert: Sandbox-Detonation, beobachtete SBOMs, signierte Provenance, eingezäunte Feeds und ring-basierte Verteilung mit Rollback.',
    tech: '.NET · PostgreSQL · Docker · in-toto / SLSA · CycloneDX · Sigstore · Authenticode · winget',
    links: [{ label: 'Attestree', href: '/projects/attestree/' }],
  },
  {
    title: 'Endpoint Management',
    depth: 'Hands-on Umsetzung',
    strategic: false,
    text: 'Vollautomatisierte Endpoint-Compliance- und BIOS-Lifecycle-Plattform: Configuration-as-Code, ringbasiertes Rollout und unternehmensweite Compliance-Sichtbarkeit.',
    tech: 'Microsoft Intune · Win32-Paketierung · BitLocker · OEM-Kataloge · Log Analytics · Logic Apps',
    links: [{ label: 'Komponentenreferenz', href: '/projects/cloud-infrastructure/components' }],
  },
  {
    title: 'Security & Observability',
    depth: 'Hands-on Umsetzung',
    strategic: false,
    text: 'Zentrale SIEM-Plattform für Bedrohungserkennung und standortübergreifende Korrelation: von verteilten, nicht korrelierbaren Logs zu unternehmensweiter Sicherheitssichtbarkeit.',
    tech: 'Elastic Stack · Kibana · Winlogbeat · Azure Monitor · Prometheus · Grafana · OpenTelemetry',
    links: [{ label: 'Cloud & Hybrid Infrastructure', href: '/projects/cloud-infrastructure/architecture' }],
  },
  {
    title: 'Automation & CI/CD',
    depth: 'Strategische Verantwortung',
    strategic: true,
    text: 'Infrastructure-as-Code, Deployment-Automatisierung und Pipeline-Architektur über verschiedene Plattformen: von Enterprise-SaaS-Infrastruktur über Cloud-Automation bis zu täglichen Release-Zyklen mit Gates.',
    tech: 'PowerShell · Ansible · GitHub Actions · Bamboo · Azure Automation · Docker · Python · TypeScript',
    links: [
      { label: 'SaaS CI/CD Pipeline', href: '/projects/cicd-automation/' },
      { label: 'SmallCapTrader', href: '/projects/smallcaptrader/' },
    ],
  },
];
---

<PageLayout title="Kompetenzen — Marc Borer" description="Kompetenzen von Marc Borer: Identity & Access, Cloud & Messaging, Software Supply Chain, Endpoint Management, Security & Observability, Automation & CI/CD." ogImage="/og/skills.png">
  <header class="page-head">
    <span class="eyebrow">Kompetenzen</span>
    <h1>Sechs Domänen, jede mit Beleg.</h1>
    <p class="lead">
      Architekturverantwortung über den gesamten Lebenszyklus unternehmenskritischer Infrastruktur: von der Evaluierung und Technologieentscheidung über die Umsetzung bis zum stabilen Betrieb. Jede Domäne verweist auf das Projekt, in dem sie belegt ist.
    </p>
  </header>

  <section class="section">
    <div class="plates">
      {domains.map((d) => (
        <article class="plate">
          <div class="plate-head">
            <h2 class="plate-title">{d.title}</h2>
            <span class:list={['depth', d.strategic ? 'depth--strategic' : 'depth--hands-on']}>{d.depth}</span>
          </div>
          <p class="plate-text">{d.text}</p>
          <p class="plate-tech">{d.tech}</p>
          <div class="plate-links">
            {d.links.map((l) => (
              <a href={getRelativeLocaleUrl('de', l.href)} class="link-arrow">
                {l.label}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>
</PageLayout>

<style>
  .plates {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--space-12);
  }

  .plate {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    padding-block: var(--space-8);
    border-top: var(--rule) solid var(--hairline-strong);
  }

  .plate-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }

  .plate-title {
    font-size: var(--text-xl);
  }

  .depth {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .depth--strategic {
    color: var(--accent);
  }

  .depth--hands-on {
    color: var(--signal);
  }

  .plate-text {
    line-height: var(--leading-prose);
    color: var(--ink-2);
  }

  .plate-tech {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.7;
    color: var(--muted);
  }

  .plate-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
  }

  @media (max-width: 760px) {
    .plates {
      grid-template-columns: 1fr;
    }
  }
</style>
