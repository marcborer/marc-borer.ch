---
import PageLayout from '../../layouts/PageLayout.astro';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';

const lang = (Astro.currentLocale || 'de') as Lang;
const t = useTranslations(lang);
const title = lang === 'de' ? 'Kontakt — Marc Borer' : 'Contact — Marc Borer';
const description = lang === 'de'
  ? 'Kontakt zu Marc Borer für Enterprise-Infrastruktur, Cloud-Architektur, Automatisierung und Software-Lieferketten.'
  : 'Get in touch with Marc Borer for enterprise infrastructure, cloud architecture, automation and software supply chains.';
---

<PageLayout title={title} description={description}>
  <header class="page-head">
    <span class="eyebrow">{t('nav.contact')}</span>
    <h1>{t('contact.title')}</h1>
    <p class="lead">{t('contact.intro')}</p>
  </header>

  <section class="section contact">
    <ul class="channels" role="list">
      <li class="channel channel--primary">
        <span class="channel-label">{t('contact.email')}</span>
        <div class="channel-main">
          <a href="mailto:mb@marc-borer.ch" class="channel-value">mb@marc-borer.ch</a>
          <span class="channel-note">{t('contact.email.note')}</span>
        </div>
        <button type="button" class="btn btn--ghost copy-btn" data-copy="mb@marc-borer.ch" data-copied={t('contact.copied')}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="1.5"/><path d="M5 15V5.5A1.5 1.5 0 0 1 6.5 4H15"/></svg>
          <span class="copy-label">{t('contact.copy')}</span>
        </button>
      </li>
      <li class="channel">
        <span class="channel-label">GitHub</span>
        <div class="channel-main">
          <a href="https://github.com/marcborer" class="channel-value" target="_blank" rel="noopener noreferrer">github.com/marcborer</a>
          <span class="channel-note">{t('contact.github.note')}</span>
        </div>
      </li>
      <li class="channel">
        <span class="channel-label">LinkedIn</span>
        <div class="channel-main">
          <a href="https://linkedin.com/in/marc-b-6780ab5a/" class="channel-value" target="_blank" rel="noopener noreferrer">linkedin.com/in/marc-b-6780ab5a</a>
          <span class="channel-note">{t('contact.linkedin.note')}</span>
        </div>
      </li>
      <li class="channel">
        <span class="channel-label">Attestree</span>
        <div class="channel-main">
          <a href="https://attestree.com" class="channel-value" target="_blank" rel="noopener noreferrer">attestree.com</a>
          <span class="channel-note">{t('contact.attestree.note')}</span>
        </div>
      </li>
    </ul>

    <dl class="spec contact-spec">
      <div>
        <dt>{t('contact.location')}</dt>
        <dd>{t('contact.location.value')}</dd>
      </div>
      <div>
        <dt>{t('contact.languages')}</dt>
        <dd>{t('contact.languages.value')}</dd>
      </div>
    </dl>
  </section>
</PageLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const value = btn.dataset.copy ?? '';
      const label = btn.querySelector<HTMLElement>('.copy-label');
      const original = label?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(value);
        if (label) label.textContent = btn.dataset.copied ?? original;
        setTimeout(() => { if (label) label.textContent = original; }, 1600);
      } catch {
        window.location.href = `mailto:${value}`;
      }
    });
  });
</script>

<style>
  .contact {
    display: grid;
    gap: var(--space-12);
    max-width: 60rem;
  }

  .channels {
  }

  .channel {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr) auto;
    gap: var(--space-4) var(--space-6);
    align-items: center;
    padding-block: var(--space-6);
    border-bottom: var(--rule) solid var(--hairline);
  }

  .channel-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .channel-main {
    display: grid;
    gap: var(--space-1);
    min-width: 0;
  }

  .channel-value {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-xl);
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .channel--primary .channel-value {
    font-stretch: 110%;
    font-size: var(--text-2xl);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }

  .channel-value:hover {
    color: var(--accent);
  }

  .channel-note {
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .contact-spec {
    max-width: 40rem;
  }

  @media (max-width: 640px) {
    .channel {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }

    .copy-btn {
      justify-self: start;
    }
  }
</style>
