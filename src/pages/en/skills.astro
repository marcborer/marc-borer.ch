---
import PageLayout from '../../layouts/PageLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';

const domains = [
  {
    title: 'Identity & Access',
    depth: 'Strategic ownership',
    strategic: true,
    text: 'Hybrid identity architecture, lifecycle automation and an enterprise-wide authentication strategy, with a focus on governance and clean coexistence of on-premises and cloud.',
    tech: 'Entra ID · Active Directory · Conditional Access · MFA · Graph API · Azure Automation',
    links: [{ label: 'Cloud & Hybrid Infrastructure', href: '/projects/cloud-infrastructure/architecture' }],
  },
  {
    title: 'Cloud & Messaging',
    depth: 'Strategic ownership',
    strategic: true,
    text: 'Migration and operation of the company-wide communications platform: architecture decision, migration strategy, vendor evaluation and uninterrupted service through the switch.',
    tech: 'Exchange Online · Exchange Hybrid · Microsoft Teams · Direct Routing · SBC · PowerShell',
    links: [{ label: 'Cloud & Hybrid Infrastructure', href: '/projects/cloud-infrastructure/architecture' }],
  },
  {
    title: 'Software Supply Chain & Platform Engineering',
    depth: 'Hands-on delivery',
    strategic: false,
    text: 'Designing and building a control plane that attests software before rollout: sandbox detonation, observed SBOMs, signed provenance, fenced feeds and ring-based delivery with rollback.',
    tech: '.NET · PostgreSQL · Docker · in-toto / SLSA · CycloneDX · Sigstore · Authenticode · winget',
    links: [{ label: 'Attestree', href: '/projects/attestree/' }],
  },
  {
    title: 'Endpoint Management',
    depth: 'Hands-on delivery',
    strategic: false,
    text: 'A fully automated endpoint compliance and BIOS lifecycle platform: configuration as code, ring-based rollout and fleet-wide compliance visibility.',
    tech: 'Microsoft Intune · Win32 packaging · BitLocker · OEM catalogs · Log Analytics · Logic Apps',
    links: [{ label: 'Component reference', href: '/projects/cloud-infrastructure/components' }],
  },
  {
    title: 'Security & Observability',
    depth: 'Hands-on delivery',
    strategic: false,
    text: 'A central SIEM platform for threat detection and cross-site correlation: from scattered, uncorrelated logs to enterprise-wide security visibility.',
    tech: 'Elastic Stack · Kibana · Winlogbeat · Azure Monitor · Prometheus · Grafana · OpenTelemetry',
    links: [{ label: 'Cloud & Hybrid Infrastructure', href: '/projects/cloud-infrastructure/architecture' }],
  },
  {
    title: 'Automation & CI/CD',
    depth: 'Strategic ownership',
    strategic: true,
    text: 'Infrastructure as code, deployment automation and pipeline architecture across platforms: from enterprise SaaS infrastructure and cloud automation to daily release cycles with gates.',
    tech: 'PowerShell · Ansible · GitHub Actions · Bamboo · Azure Automation · Docker · Python · TypeScript',
    links: [
      { label: 'SaaS CI/CD Pipeline', href: '/projects/cicd-automation/' },
      { label: 'SmallCapTrader', href: '/projects/smallcaptrader/' },
    ],
  },
];
---

<PageLayout title="Skills — Marc Borer" description="Skills of Marc Borer: identity & access, cloud & messaging, software supply chain, endpoint management, security & observability, automation & CI/CD." ogImage="/og/skills.png">
  <header class="page-head">
    <span class="eyebrow">Skills</span>
    <h1>Six domains, each with evidence.</h1>
    <p class="lead">
      Architecture ownership across the whole lifecycle of business-critical infrastructure: from evaluation and technology decisions through implementation to stable operations. Each domain points to the project where it is evidenced.
    </p>
  </header>

  <section class="section">
    <div class="plates">
      {domains.map((d) => (
        <article class="plate">
          <div class="plate-head">
            <h2 class="plate-title">{d.title}</h2>
            <span class:list={['depth', d.strategic ? 'depth--strategic' : 'depth--hands-on']}>{d.depth}</span>
          </div>
          <p class="plate-text">{d.text}</p>
          <p class="plate-tech">{d.tech}</p>
          <div class="plate-links">
            {d.links.map((l) => (
              <a href={getRelativeLocaleUrl('en', l.href)} class="link-arrow">
                {l.label}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>
</PageLayout>

<style>
  .plates {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--space-12);
  }

  .plate {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    padding-block: var(--space-8);
    border-top: var(--rule) solid var(--hairline-strong);
  }

  .plate-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }

  .plate-title {
    font-size: var(--text-xl);
  }

  .depth {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .depth--strategic {
    color: var(--accent);
  }

  .depth--hands-on {
    color: var(--signal);
  }

  .plate-text {
    line-height: var(--leading-prose);
    color: var(--ink-2);
  }

  .plate-tech {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.7;
    color: var(--muted);
  }

  .plate-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
  }

  @media (max-width: 760px) {
    .plates {
      grid-template-columns: 1fr;
    }
  }
</style>
