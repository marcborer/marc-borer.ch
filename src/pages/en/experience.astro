---
import PageLayout from '../../layouts/PageLayout.astro';
import Timeline from '../../components/Timeline.astro';
import experience from '../../data/experience.en.json';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';

const lang = (Astro.currentLocale || 'de') as Lang;
const t = useTranslations(lang);
const cvHref = 'https://github.com/marcborer/cv/releases/latest/download/CV-Marc-Borer-EN.pdf';
const training = [
  { year: '2025', title: 'Designing and Implementing Microsoft DevOps Solutions', where: 'Digicomp, Zurich · 4 days' },
  { year: '2019', title: 'PowerShell: Advanced Techniques', where: 'Digicomp, Zurich · 2 days' },
];
---

<PageLayout title="Career — Marc Borer" description="Career of Marc Borer: systems engineering, IT operations, architecture ownership at CTC Analytics and, since 2026, founder of Attestree.">
  <header class="page-head">
    <span class="eyebrow">{t('nav.experience')}</span>
    <h1>{t('experience.title')}</h1>
    <p class="lead">{t('experience.lead')}</p>
    <div class="page-head-actions">
      <a href={cvHref} class="btn btn--primary" target="_blank" rel="noopener noreferrer">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M4 19h16"/></svg>
        {t('experience.download')}
      </a>
    </div>
  </header>

  <section class="section">
    <Timeline entries={experience} />
  </section>

  <section class="section">
    <div class="section-head">
      <div class="section-head-group">
        <span class="eyebrow">{t('experience.education')}</span>
      </div>
    </div>
    <ul class="training" role="list">
      {training.map((item) => (
        <li class="training-row">
          <span class="training-year">{item.year}</span>
          <span class="training-title">{item.title}</span>
          <span class="training-where">{item.where}</span>
        </li>
      ))}
    </ul>
  </section>
</PageLayout>

<style>
  .training {
    max-width: 60rem;
  }

  .training-row {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr) minmax(0, 16rem);
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: var(--rule) solid var(--hairline);
    align-items: baseline;
  }

  .training-year {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink);
    text-align: right;
  }

  .training-title {
    color: var(--ink);
    font-weight: 500;
  }

  .training-where {
    font-size: var(--text-sm);
    color: var(--muted);
  }

  @media (max-width: 700px) {
    .training-row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }

    .training-year {
      text-align: left;
    }
  }
</style>
