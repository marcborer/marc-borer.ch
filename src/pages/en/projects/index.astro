---
import PageLayout from '../../../layouts/PageLayout.astro';
import ProjectRow from '../../../components/ProjectRow.astro';
import projects from '../../../data/projects.en.json';
import { useTranslations } from '../../../i18n/utils';
import type { Lang } from '../../../i18n/utils';

const lang = (Astro.currentLocale || 'de') as Lang;
const t = useTranslations(lang);
---

<PageLayout title="Projects — Marc Borer" description="Case studies by Marc Borer: Attestree, enterprise cloud and hybrid infrastructure, CI/CD automation and two trading platforms." ogImage="/og/projects.png">
  <header class="page-head">
    <span class="eyebrow">{t('nav.projects')}</span>
    <h1>{t('projects.title')}</h1>
    <p class="lead">{t('projects.lead')}</p>
  </header>

  <div class="register register--page">
    {projects.map((project) => (
      <ProjectRow
        title={project.title}
        period={project.period}
        description={project.description}
        tech={project.tech}
        link={project.link}
      />
    ))}
  </div>
</PageLayout>

<style>
  .register--page {
    border-top: none;
  }
</style>
