  "@type": "SoftwareApplication",
  "name": "Attestree",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Windows",
  "url": "https://attestree.com",
  "description": "App-patching control plane for Windows fleets that attests every winget, Chocolatey and Scoop version at ingest: sandboxed detonation, an observed SBOM and a signed in-toto statement before it rolls out in rings.",
