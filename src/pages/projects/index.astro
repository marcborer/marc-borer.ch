---
import PageLayout from '../../layouts/PageLayout.astro';
import ProjectRow from '../../components/ProjectRow.astro';
import projects from '../../data/projects.de.json';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';

const lang = (Astro.currentLocale || 'de') as Lang;
const t = useTranslations(lang);
---

<PageLayout title="Projekte — Marc Borer" description="Fallstudien von Marc Borer: Attestree, Enterprise Cloud- und Hybrid-Infrastruktur, CI/CD-Automatisierung und zwei Handelsplattformen." ogImage="/og/projects.png">
  <header class="page-head">
    <span class="eyebrow">{t('nav.projects')}</span>
    <h1>{t('projects.title')}</h1>
    <p class="lead">{t('projects.lead')}</p>
  </header>

  <div class="register register--page">
    {projects.map((project) => (
      <ProjectRow
        title={project.title}
        period={project.period}
        description={project.description}
        tech={project.tech}
        link={project.link}
      />
    ))}
  </div>
</PageLayout>

<style>
  .register--page {
    border-top: none;
  }
</style>
