---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectRow from '../components/ProjectRow.astro';
import Timeline from '../components/Timeline.astro';
import projects from '../data/projects.de.json';
import experience from '../data/experience.de.json';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';

const lang = (Astro.currentLocale || 'de') as Lang;
const t = useTranslations(lang);
const career = experience.filter((e) => e.kind !== 'Auszeit' && e.kind !== 'Ausbildung');
---

<PageLayout title="Marc Borer — Senior ICT Systems Architect">
  <Hero />

  <section class="section" id="projects">
    <div class="section-head">
      <div class="section-head-group">
        <span class="eyebrow">{t('section.featured')}</span>
        <h2>{t('section.featured.lead')}</h2>
      </div>
      <a href={getRelativeLocaleUrl(lang, '/projects/')} class="link-arrow">
        {t('section.viewAll')}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
    <div class="register">
      {projects.map((project) => (
        <ProjectRow
          title={project.title}
          period={project.period}
          description={project.description}
          tech={project.tech}
          link={project.link}
        />
      ))}
    </div>
  </section>

  <section class="section" id="experience">
    <div class="section-head">
      <div class="section-head-group">
        <span class="eyebrow">{t('section.experience')}</span>
        <h2>{t('section.experience.lead')}</h2>
      </div>
      <a href={getRelativeLocaleUrl(lang, '/experience/')} class="link-arrow">
        {t('section.viewTimeline')}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
    <Timeline entries={career} compact />
  </section>

  <section class="section section--contact" id="contact">
    <div class="contact-band">
      <div class="section-head-group">
        <span class="eyebrow">{t('section.contact')}</span>
        <h2>{t('section.contact.lead')}</h2>
      </div>
      <div class="contact-band-actions">
        <a href="mailto:mb@marc-borer.ch" class="contact-band-mail">mb@marc-borer.ch</a>
        <div class="contact-band-links">
          <a href="https://github.com/marcborer" target="_blank" rel="noopener noreferrer" class="btn btn--ghost">GitHub</a>
          <a href="https://linkedin.com/in/marc-b-6780ab5a/" target="_blank" rel="noopener noreferrer" class="btn btn--ghost">LinkedIn</a>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .section--contact {
    padding-bottom: var(--space-8);
  }

  .contact-band {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-10);
    align-items: end;
  }

  .contact-band h2 {
    font-size: var(--text-2xl);
    max-width: 30ch;
  }

  .contact-band-actions {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .contact-band-mail {
    font-family: var(--font-display);
    font-stretch: 110%;
    font-weight: 600;
    font-size: var(--text-xl);
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }

  .contact-band-mail:hover {
    color: var(--accent);
  }

  .contact-band-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (max-width: 860px) {
    .contact-band {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
</style>
